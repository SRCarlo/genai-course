# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Cost rates are configurable.
# Put your current Groq pricing here in USD per 1M tokens.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0

# Budget examples in USD
DAILY_BUDGET=10
MONTHLY_BUDGET=100
TENANT_BUDGET=5

# Token / execution guardrails
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=1500
MAX_CONTEXT_TOKENS=4000
MAX_TOOL_CALLS=5
MAX_RETRIES=2

# Demo / development
ENABLE_LIVE_GROQ=false