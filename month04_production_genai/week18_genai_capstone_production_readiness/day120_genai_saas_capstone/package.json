{
  "name": "day120-genai-saas-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant GenAI knowledge assistant capstone using Groq and openai/gpt-oss-20b",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check src/server.js && node --check src/app.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/multer": "^2.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^4.1.12"
  }
}
