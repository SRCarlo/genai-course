# Never commit your real .env file.
# Create .env locally and replace these blank values with your own secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Generate unique random tenant API keys locally. Do not reuse your Groq key.
ACME_API_KEY=
BETA_API_KEY=
ENTERPRISE_API_KEY=

PORT=3000
LOG_LEVEL=info
